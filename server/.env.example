# Database (Neon or Supabase connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_32_chars

# Server
PORT=5000
CLIENT_URL=http://localhost:5173,https://your-civicconnect.vercel.app

# Google Gemini AI (Multimodal issue classification & proof-of-fix verification)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Image Storage (Optional - falls back to base64 if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notifications (Optional - logs to console if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
MAIL_FROM=CivicConnect <noreply@civicconnect.org>
